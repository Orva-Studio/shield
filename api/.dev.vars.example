# Copy this file to .dev.vars and fill in your values
# These are secrets that should NOT be committed to git

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-here-at-least-32-characters

# Google OAuth credentials (optional, for Google sign-in)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend API key (required for email verification and password reset)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
